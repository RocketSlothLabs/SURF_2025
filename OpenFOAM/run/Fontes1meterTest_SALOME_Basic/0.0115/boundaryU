FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0.0115";
    object      boundaryU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 -500);
    }
    outlet
    {
        type            fixedValue;
        value           uniform (10000 10000 10000);
    }
    lateralWall
    {
        type            noSlip;
    }
    floorWall
    {
        type            noSlip;
    }
    symmetryX
    {
        type            symmetry;
    }
    symmetryY
    {
        type            symmetry;
    }
}


