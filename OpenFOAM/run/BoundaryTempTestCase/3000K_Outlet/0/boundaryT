        type            fixedValue;
        value           uniform 3000;
    }

    lateralWall
    {
        type            fixedValue;
        value           uniform 200;
    }
    
    floorWall
    {
        type            fixedValue;
        value           uniform 200;
    }

    symmetryX
    {
        type            empty;
    }
    
    symmetryY
    {
        type            empty;
    }
